[node name="ReputationLabel" type="Label" parent="Margin/Root/TopBar"]
unique_name_in_owner = true
layout_mode = 2
text = "Rep: 12"

[node name="Spacer" type="Control" parent="Margin/Root/TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="SaveButton" type="Button" parent="Margin/Root/TopBar"]
layout_mode = 2
text = "Save"

[node name="DiagramButton" type="Button" parent="Margin/Root/TopBar"]
layout_mode = 2
text = "Diagram"

[node name="HintButton" type="Button" parent="Margin/Root/TopBar"]
layout_mode = 2
text = "Hint"

[node name="MenuButton" type="Button" parent="Margin/Root/TopBar"]
layout_mode = 2
text = "Menu"

[node name="DebriefCard" type="PanelContainer" parent="Margin/Root"]
layout_mode = 2

[node name="DebriefVBox" type="VBoxContainer" parent="Margin/Root/DebriefCard"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="DebriefToggle" type="Button" parent="Margin/Root/DebriefCard/DebriefVBox"]
unique_name_in_owner = true
layout_mode = 2
flat = true
text = "▶ Last quarter debrief"
alignment = 0

[node name="DebriefBody" type="VBoxContainer" parent="Margin/Root/DebriefCard/DebriefVBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 4

[node name="DebriefLabel" type="Label" parent="Margin/Root/DebriefCard/DebriefVBox/DebriefBody"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
text = "Welcome to Capital Farm."

[node name="DebriefSummary" type="Label" parent="Margin/Root/DebriefCard/DebriefVBox/DebriefBody"]
