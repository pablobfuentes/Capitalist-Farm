[gd_scene load_steps=3 format=3 uid="uid://econgame_dashboard"]

[ext_resource type="Script" path="res://ui/screens/dashboard.gd" id="1_dash"]
[ext_resource type="Script" path="res://ui/components/progress_graph.gd" id="2_graph"]

[node name="Dashboard" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_dash")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.09, 0.08, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="Root" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TopBar" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="TurnLabel" type="Label" parent="Margin/Root/TopBar"]
unique_name_in_owner = true
layout_mode = 2
text = "Turn 1 / 30"

[node name="CashLabel" type="Label" parent="Margin/Root/TopBar"]
unique_name_in_owner = true
layout_mode = 2
text = "Cash: $0"

[node name="NetWorthLabel" type="Label" parent="Margin/Root/TopBar"]
unique_name_in_owner = true
layout_mode = 2
