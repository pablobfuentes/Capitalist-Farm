; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="EconGame"
config/description="Capital Farm economy sim — Godot port of EconomyGame MVP 6"
run/main_scene="res://ui/screens/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://autoload/game.gd"
EventBus="*res://autoload/event_bus.gd"
Content="*res://autoload/content_registry.gd"
AiClient="*res://autoload/ai_client.gd"
NegotiationContent="*res://autoload/negotiation_content.gd"

[debug]

gdscript/warnings/untyped_declaration=0

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/gut_plugin.gd")

[rendering]

renderer/rendering_method="mobile"
